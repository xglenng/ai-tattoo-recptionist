DATABASE_URL=postgresql://tattoo:tattoo@localhost:5432/tattoo_ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Encrypt integration tokens before production. Sprint 3 uses a development placeholder.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Sprint 5 - Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=http://localhost:3000/api/twilio/inbound
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_DEFAULT_ORGANIZATION_ID=
TWILIO_DEFAULT_ARTIST_ID=
AUTOMATION_CRON_SECRET=

# Sprint 6.2 - per-artist Twilio tenant infrastructure
# Generate with: openssl rand -base64 32
TWILIO_ENCRYPTION_KEY=
# Public HTTPS base URL used for Twilio inbound webhooks. For local development use an HTTPS tunnel such as ngrok.
TWILIO_WEBHOOK_BASE_URL=
# Set to mock to exercise provisioning flow without creating Twilio resources.
TWILIO_PROVISION_MODE=live

# Sprint 6.3 - A2P registration intake
# Generate with: openssl rand -base64 32 (falls back to TWILIO_ENCRYPTION_KEY if omitted)
COMPLIANCE_ENCRYPTION_KEY=
# Keep this set to mock until live Trust Hub submission is configured and reviewed.
TWILIO_COMPLIANCE_MODE=mock

# Sprint 6.4: required to issue client waiver links. Generate: openssl rand -hex 32
WAIVER_SIGNING_SECRET=
# Never commit credentials. Supply AUTH_USER_ID and AUTH_PASSWORD only when running auth:setup.
